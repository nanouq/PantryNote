@model PerishableItem
@{
    ViewData["Title"] = "Add Perishable Item";
}

<form class="border border-2 mt-2 p-3 rounded shadow" method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <div class="d-flex align-items-center">

                <a asp-controller="Pantry" asp-action="Add" class="btn text-dark me-2">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <h1 class="section-title">Add perishable item</h1>
                
            </div>
            <hr />
        </div>
        <div class="mb-3 row p-1">
            <label class="form-label section-body">Name</label>
            <input asp-for="Name" type="text" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label class="form-label section-body">Brand <span class="text-muted">(optional)</span></label>
            <input asp-for="Brand" class="form-control" />
            <span asp-validation-for="Brand" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label class="form-label section-body">Category</label>
            <select asp-for="Category" class="form-select">
                <option value="Dairy">Dairy</option>
                <option value="Frozen">Frozen</option>
                <option value="Meats">Meats</option>
                <option value="Produce">Produce</option>
                <option value="Beverages">Beverages</option>
                <option value="Bakery">Bakery</option>
                <option value="Canned Goods">Canned Goods</option>
                <option value="Dry Goods">Dry Goods</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="mb-3 row p-1">
            <div class="col-9">
                <label class="form-label section-body">Quantity</label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="col-3 ">
                <label class="form-label section-body">Unit</label>
                <input asp-for="Unit" class="form-control" placeholder="e.g., Each, Ounces, Pounds" />
                <span asp-validation-for="Unit" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 row p-1">
            <label class="form-label section-body">Location</label>
            <input asp-for="Location" class="form-control" placeholder="e.g., Pantry, Fridge, Freezer" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label class="form-label section-body">Expiration Date <span class="text-muted">(optional)</span></label>
            <input asp-for="ExpirationDate" type="date" class="form-control" placeholder="e.g., Pantry, Fridge, Freezer" />
        </div>

        <div class="mb-3 p-1">
            <label class="form-label section-body">Requires Refrigeration</label>
            <div class="btn-group" role="group">
                <input asp-for="RequiresRefrigeration" type="radio" class="btn-check" name="RequiresRefrigeration" id="reqRefTrue" value="true" />
                <label class="btn btn-outline-secondary" for="reqRefTrue">Yes</label>

                <input asp-for="RequiresRefrigeration" type="radio" class="btn-check" name="RequiresRefrigeration" id="reqRefFalse" value="false" checked />
                <label class="btn btn-outline-secondary" for="reqRefFalse">No</label>
            </div>
            <span asp-validation-for="RequiresRefrigeration" class="text-danger"></span>
        </div>

        <div class="mb-3 p-1">
            <label class="form-label section-body">Requires Freezing</label>
            <div class="btn-group" role="group">
                <input asp-for="RequiresFreezing" type="radio" class="btn-check" name="RequiresFreezing" id="reqFrzTrue" value="true" />
                <label class="btn btn-outline-secondary" for="reqFrzTrue">Yes</label>

                <input asp-for="RequiresFreezing" type="radio" class="btn-check" name="RequiresFreezing" id="reqFrzFalse" value="false" checked/>
                <label class="btn btn-outline-secondary" for="reqFrzFalse">No</label>
            </div>
            <span asp-validation-for="RequiresFreezing" class="text-danger"></span>

        </div>

        <div class="row">
            <div class="col-6">
                <button type="submit" class="btn btn-secondary form-control">Add</button>
            </div>
            <div class="col-6">
                <a asp-controller="Pantry" asp-action="Index" class="btn btn-outline-secondary form-control">Back to pantry</a>
            </div>
        </div>


    </div>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial"/>
    }
}
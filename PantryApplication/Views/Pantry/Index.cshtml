@using Microsoft.AspNetCore.Identity
@model List<Item>
@{
    ViewData["Title"] = "My Pantry";
}
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<partial name="_Notification"/>
@if (Model == null || !Model.Any())
{
    <div class="container-fluid py-3">
        <h2 class="section-text">Welcome to your pantry, @UserManager.GetUserAsync(User).Result.Name.</h2>
        <div class="row justify-content-center py-5">
            <img src="~/css/img/illustrator-drawing-paint.svg" class="img-fluid" style="max-width: 400px;" /> 
        </div>
        <div class="row text-center py-1">
            <h3 class="section-text">It looks like your pantry is empty. Add your first item now!</h3>
        </div>
        <div class="row align-items-center py-3">
            <div class="text-center">
                <a class="btn btn-secondary mt-3 hero-button" asp-controller="Pantry" asp-action="Add">Add Item</a>
            </div>
        </div>

    </div>  
}
else
{
<div class="container">
    <div class="row pt-4 pb-4">
        <div class="col-6">
            <h2 class="section-text">Welcome to your pantry, @UserManager.GetUserAsync(User).Result.Name.</h2>
        </div>
        <div class="col-6 text-end d-flex justify-content-end align-items-center">
            <a asp-controller="Pantry" asp-action="Add" class="btn btn-secondary ms-2 align-self-stretch align-content-center">
                <i class="bi bi-plus-circle"></i> Add item
            </a>
        </div>
    </div>
    <div class="row pb-4">
        <div class="d-flex justify-content-between align-items-center">
            <form asp-controller="Pantry" asp-action="Search" method="get" class="d-flex flex-grow-1 me-2">
                <input type="text" name="search" class="form-control me-2" placeholder="Search items" />
                <button type="submit" class="btn btn-primary">
                    Search
                </button>
            </form>
            
            <button type="button" class="btn btn-outline-primary text-decoration-none" data-bs-toggle="modal" data-bs-target="#reportModal">
                <i class="bi bi-file-text-fill"></i>Generate Report
            </button>
        </div>           
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover border-primary-subtle rounded">
            <thead>
                <tr>
                    <th>
                        Name
                    </th>
                    <th>
                        Category
                    </th>
                    <th>
                        Brand
                    </th>
                    <th>
                        Quantity
                    </th>
                    <th>
                        Location
                    </th>
                    <th>
                        Expiration
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td><a asp-controller="Pantry" asp-action="Details" asp-route-id="@obj.Id" class="text-decoration-none text-dark">@obj.Name</a></td>
                        <td>@obj.Category</td>
                        <td>@(!string.IsNullOrEmpty(obj.Brand) ? obj.Brand : "Not set")</td>                   
                        <td>@obj.Quantity @obj.Unit</td>
                        <td>@obj.Location</td>
                        <td>@(obj.ExpirationDate.HasValue ? obj.ExpirationDate.Value.ToString("d") : "Not set")</td>
                        <td>
                            <div class="w-100 btn-group" role="group">
                                <a asp-controller="Pantry" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-secondary mx-1">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button class="btn btn-secondary mx-1" data-bs-toggle="modal" data-bs-target="#deleteModal" 
                                onclick="setDeleteFormAction(@obj.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1"> 
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"></span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this item?</p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <button type="submit" class="btn btn-secondary">Yes, delete</button>
                </form>    
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">No, cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Report Modal -->
<div class="modal fade" id="reportModal" tabindex="1" aria-labelledby="reportModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reportModalLabel">Generate Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="reportForm" asp-controller="Pantry" asp-action="Report" method="post">
                    <div class="mb-3">
                        <label for="reportType" class="form-label">Select a type of report:</label>
                        <select class="form-select" id="reportType" name="reportType" required>
                            <option value="" disabled selected>Choose a report type</option>
                            <option value="1">Items Expiring Soon</option>
                            <option value="2">Category Count</option>
                            <option value="3">Option 3</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-secondary">Generate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteFormAction(itemId) {
        const form = document.getElementById('deleteForm');
        form.action = `/Pantry/Delete/${itemId}`;
    }
</script>
}
@model NonPerishableItem

<form class="border border-secondary-subtle border-2 mt-2 p-2 rounded" method="post">
    <input asp-for="PantryId" hidden />
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2>Add non-perishable item</h2>
            <hr />
        </div>
        <div class="mb-3 row p-1">
            <label class="form-label">Name</label>
            <input asp-for="Name" type="text" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label class="form-label">Brand</label>
            <input asp-for="Brand" class="form-control" />
            <span asp-validation-for="Brand" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label class="form-label">Category</label>
            <select asp-for="Category" class="form-select">
                <option value="">-- Select Category --</option>
                <option value="Dairy">Dairy</option>
                <option value="Frozen">Frozen</option>
                <option value="Meats">Meats</option>
                <option value="Produce">Produce</option>
                <option value="Beverages">Beverages</option>
                <option value="Bakery">Bakery</option>
                <option value="Canned Goods">Canned Goods</option>
                <option value="Dry Goods">Dry Goods</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="row">
            <div class="col-9 mb-3 p-1">
                <label class="form-label">Quantity</label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="col-3 mb-3  p-1">
                <label class="form-label">Unit</label>
                <input asp-for="Unit" class="form-control" placeholder="e.g., Each, Ounces, Pounds" />
                <span asp-validation-for="Unit" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 p-1">
            <label class="form-label">Location</label>
            <input asp-for="Location" class="form-control" placeholder="e.g., Pantry, Fridge, Freezer" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="mb-3 p-1">
            <label class="form-label">Expiration Date</label>
            <input asp-for="ExpirationDate" type="date" class="form-control" placeholder="e.g., Pantry, Fridge, Freezer" />
        </div>

        <div class="mb-3">
            <label class="form-label">Is your item sealed?</label>
            <div class="btn-group" role="group">
                <input asp-for="IsSealed" type="radio" class="btn-check" name="IsSealed" id="sealedTrue" value="true" />
                <label class="btn btn-outline-secondary" for="sealedTrue">Yes</label>

                <input asp-for="IsSealed" type="radio" class="btn-check" name="IsSealed" id="sealedFalse" value="false"/>
                <label class="btn btn-outline-secondary" for="sealedFalse">No</label>
            </div>
        </div>

        <div class="row">
            <div class="col-6">
                <button type="submit" class="btn btn-secondary form-control">Update</button>
            </div>
            <div class="col-6">
                <a asp-controller="Pantry" asp-action="Index" class="btn btn-outline-secondary form-control">Back to pantry</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
@model Item
@{
    decimal number = @Model.Quantity;
    string formattedNumber = number % 1 == 0 ? number.ToString("0") : number.ToString("0.##");
    ViewData["Title"] = @Model.Name;
}

<div class="container mt-5">
    <div class="card shadow-lg rounded">
        <div class="card-header py-4 bg-secondary-subtle">
            <div class="row">
                <div class="col-1">
                    <a asp-controller="Pantry" asp-action="Index" class="btn text-dark">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </div>
                <div class="col-11 text-center">
                    <h4>Item Details</h4>
                </div>
            </div>
        </div>
        <div class="row g-0 py-3">
            <div class="col-md-4">
                <img src="~/css/img/Vegetables.svg"/>
            </div>

            <div class="col-md-8">
                <div class="card-body">
                    <h2 class="card-title">@Model.Name <small class="opacity-75 fst-italic"> @Model.Brand</small></h2>
                    <hr />

                    <div class="card-text">
                        <p><strong>Category: </strong>@Model.Category</p>
                        <p><strong>Date added: </strong>@Model.DateAdded.ToString("d")</p>
                        <p><strong>Expiration date: </strong>@Model.ExpirationDate.Value.ToString("d")</p>
                        <p><strong>Quantity: </strong>@formattedNumber @Model.Unit</p>
                        <p><strong>Location: </strong>@Model.Location</p>
                        <p><strong>Is this item expired?: </strong>@Model.IsExpired()</p>
                        <p><strong>Storage instructions: </strong>@Model.GetStorageInstructions()</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@model Item
@{
    ViewData["Title"] = @Model.Name;
}

<div class="container mt-5">
    <div class="card shadow-lg rounded">
        <div class="card-header py-4 bg-secondary-subtle">
            <div class="row">
                <div class="col-1">
                    <a asp-controller="Pantry" asp-action="Index" class="btn text-dark">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </div>
                <div class="col-11 text-center">
                    <h3 class="section-title">Item Details</h3>
                </div>
            </div>
        </div>
        <div class="row g-0 py-3">
            <div class="col-md-4">
                <img src="~/css/img/Vegetables.svg"/>
            </div>

            <div class="col-md-8">
                <div class="card-body">
                    <h2 class="card-title">@Model.Name <small class="opacity-75 fst-italic"> @(!string.IsNullOrEmpty(Model.Brand) ? Model.Brand : "Not set")</small></h2>
                    <hr />

                    <div class="card-text">
                        <p class="section-body"><strong>Category: </strong>@Model.Category</p>
                        <p class="section-body"><strong>Date added: </strong>@Model.DateAdded.ToString("d")</p>
                        <p class="section-body"><strong>Expiration date: </strong>@(Model.ExpirationDate.HasValue ? Model.ExpirationDate.Value.ToString("d") : "Not set")</p>
                        <p class="section-body"><strong>Quantity: </strong>@Model.GetFormattedQuantity() @Model.Unit</p>
                        <p class="section-body"><strong>Location: </strong>@Model.Location</p>
                        <p class="section-body"><strong>Is this item expired?: </strong>@Model.IsExpired()</p>
                        <p class="section-body"><strong>Storage instructions: </strong>@Model.GetStorageInstructions()</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Home Page";
}

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


<div class="container-fluid hero-container">
    <div class="row align-items-center mt-lg-5">
        <div class="col-md order-last text-center text-md-start ms-lg-4">
            <h1 class="display-3 section-text">A Digital Pantry for Simplifying Your Life</h1>
            <p class="section-body">Never forget what's in your pantry again.</p>
             
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="btn btn-secondary mt-3 hero-button" asp-controller="Pantry" asp-action="Index">Get Started</a>
            }
            else
            {
                <a class="btn btn-secondary mt-3 hero-button" asp-area="Identity" asp-page="/Account/Register">Get Started</a>
            }
            
        </div>
        <div class="col-md order-first me-5 ">
            <img src="~/css/img/pantry-hero.svg"class="img-fluid" style="width:100%; height: auto;"/>
        </div>
    </div>
</div>

<div class="container-fluid  p-5" >
    <div class="row align-items-center ">
        <div class="col-md text-center text-md-start">
            <h1 class="display-5  section-text">Your pantry, whenever, wherever!</h1>
            <p class="mt-4 section-body">Have you ever double-bought a pantry item, only to find an unopened box gathering dust in the back? 
                Or run to the store for salt, forgetting you’ve run out? Say no more! With our app, 
                those days are as lost as a rice grain in your kitchen floor tiles.</p>
        </div>
        <div class="col-md-4">
            <img src="~/css/img/to-do-notes.svg" class="img-fluid" style="width:100%; height: auto;" />
        </div>
    </div>
</div>

<div class="container-fluid p-5">
    <div class="row align-items-center mt-5">
        <div class="text-center">
            <h1 class="display-5 section-text">How it works</h1>
            <p class="mt-5 section-body">
                PantryNote was designed to be a convenient digital pantry option to keep track of what’s 
                in your kitchen, so you don’t have to be in your kitchen to find out. PantryNote allows you 
                to add all of your kitchen staples to your online pantry, keeping track of important details 
                like amounts, dates, and we can even notify you when something is about to expire! Interested 
                in digitizing your pantry? Sign up now to get started!
            </p>
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="btn btn-secondary mt-3 hero-button" asp-controller="Pantry" asp-action="Index">Get Started</a>
            }
            else
            {
                <a class="btn btn-secondary mt-3 hero-button" asp-area="Identity" asp-page="/Account/Register">Get Started</a>
            }
        </div>
    </div>
</div>

<div class="row align-content-center justify-content-around pt-5">
    <div class="col-lg-3 col-sm-6">
        <div class="row p-2">
            <div class="col-13 p-1">
                <div class="card border-0 p-3 border-5 rounded">
                    <img src="~/css/img/being-at-peace.svg" class="card-img-top rounded" />
                    <div class="card-body pb-0">
                        <p class="card-title h5 text-dark opacity-75 text-center">Pantry Orgincation, Simplified</p>
                        <p class="card-body text-md-start text-center">Access your pantry anytime, anywhere. Keep track of your kicten inventory and stay on top of what matters most.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-sm-6">
        <div class="row p-2">
            <div class="col-13 p-1">
                <div class="card border-0 p-3 border-5 rounded">
                    <img src="~/css/img/bank-account.svg" class="card-img-top rounded" />
                    <div class="card-body pb-0">
                        <p class="card-title h5 text-dark opacity-75 text-center">Save Time and Save Money</p>
                        <p class="card-body text-md-start text-center">Avoid unnecessary purchases and food waste by knowing exactly what's in your pantry at all times.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-sm-6">
        <div class="row p-2">
            <div class="col-13 p-1">
                <div class="card border-0 p-3 border-5 rounded">
                    <img src="~/css/img/eco-market.svg" class="card-img-top rounded" />
                    <div class="card-body pb-0">
                        <p class="card-title h5 text-dark opacity-75 text-center">Sustainable Living Made Easy</p>
                        <p class="card-body text-md-start text-center">Contribute to a greener planet by reducing food waste and making smarter meal planning decisions.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
